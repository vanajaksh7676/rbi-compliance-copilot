GROQ_API_KEY=your-real-key
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=your-real-key
GEMINI_MODEL=gemini-2.5-flash

# Which services to use
EMBED_PROVIDER=openai          # or fastembed (free, slow on an i3)
LLM_PROVIDER=openai            # or groq (free tier)
USE_RERANKER=1                 # 0 turns off the local reranker

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=                  # copy the exact model ID from your OpenAI dashboard
OPENAI_EMBED_MODEL=text-embedding-3-small

# Groq (free fallback)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (RAGAS judge, Phase 5)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
 